# Postgres DB for scraping
POSTGRES_USER=fixtrade
POSTGRES_PASSWORD=fixtrade
POSTGRES_DB=fixtrade
POSTGRES_PORT=5432

# For local development with Docker services
SCRAPING_POSTGRES_DSN=postgresql://fixtrade:fixtrade@localhost:5432/fixtrade

# --- LLM / AI Configuration ---
# OpenRouter API (free tier available at https://openrouter.ai)
OPENROUTER_API_KEY=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

# Default LLM provider (openrouter, openai, anthropic, groq)
DEFAULT_LLM_PROVIDER=openrouter

# Default model (claude-3.5-sonnet, gpt-4, etc.)
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet

# LLM temperature (0.0-1.0, lower = more deterministic)
DEFAULT_LLM_TEMPERATURE=0.7

# Max tokens for LLM responses
DEFAULT_LLM_MAX_TOKENS=500

# Enable reasoning mode (true/false) - adds step-by-step thinking
DEFAULT_LLM_REASONING=true

# --- Application Settings ---
PROJECT_NAME=FixTrade
VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://fixtrade:fixtrade@localhost:5432/fixtrade

# --- Redis Cache ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Data Paths ---
FIXTRADE_DATA_DIR=./data
MODEL_DIR=./models

# --- ML / Prediction Settings ---
PREDICTION_CACHE_TTL=3600

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_HEAVY=10/minute
